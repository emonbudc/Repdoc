ErrorDocument 404 /404.php
DirectoryIndex index.php index.html

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://repdoc.freedev.app%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.repdoc\.freedev\.app$ [NC]
    RewriteRule ^ https://repdoc.freedev.app%{REQUEST_URI} [L,R=301]

    RewriteRule ^index\.php$ https://repdoc.freedev.app/ [R=301,L]

    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^showcase/(word|excel|ppt|psd|ai|plp)/([a-z0-9-]+)$ showcase/$1/$2/ [R=301,L]

    RewriteRule ^showcase/(word|excel|ppt|psd|ai|plp)/([a-z0-9-]+)/?$ showcase/template.php?type=$1&slug=$2 [L,QSA]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^Llms\.txt$ llms.txt [R=301,L]

    RewriteRule ^love/ - [F,L]
    RewriteRule ^src/.*\.php$ - [F,L]
    RewriteRule ^public/access_log$ - [F,L]
    RewriteRule \.(bak|sql|db|log|ini|sh|env)$ - [F,L,NC]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/plain "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
