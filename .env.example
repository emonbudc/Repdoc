# Repdoc — environment template (no secrets here).
# Copy to .env locally (excluded from Git) or set as GitHub Actions secrets.
# Local dev uses SQLite (DB_DRIVER=auto) so MySQL values may stay empty.

DB_DRIVER=auto
REPDOC_BASE_URL=
MYSQL_HOST=
MYSQL_DB=
MYSQL_USER=
MYSQL_PASS=
MYSQL_PORT=3306

# Optional enrichment (empty disables the path)
OCRSPACE_API_KEY=
GEMINI_API_KEY=
CAPTCHA_SOLVER_URL=http://localhost:8001

# Passport photo tool — free image model.
# Free Pollinations key: https://enter.pollinations.ai/keys
# Without a key the tool still works as a basic passport crop (no AI).
POLLINATIONS_API_KEY=
PASSPORT_IMAGE_PROVIDER=auto
PASSPORT_POLLINATIONS_MODEL=black-forest-labs/flux.1-kontext-pro
PASSPORT_POLLINATIONS_SIZE=896x1152
# Optional paid Gemini fallback (only used when auto + key has image access).
PASSPORT_GEMINI_MODEL=gemini-3.1-flash-image

# Land record search (tools/land). Live searches need LAND_SESSION_COOKIE;
# leave LAND_JWT_SECRET empty for holding-list results without owner details.
# Never commit a real portal cookie or signing secret.
LAND_API_BASE=https://api.ldtax.gov.bd/api/v1
LAND_SESSION_COOKIE=
LAND_JWT_SECRET=
LAND_MAX_RESULTS=25
